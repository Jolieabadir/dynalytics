# =============================================================================
# Backend environment. Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project URL and keys from Supabase > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Optional. Projects created from 2025 on sign user tokens with ES256 and
# publish the public key at {SUPABASE_URL}/auth/v1/.well-known/jwks.json, which
# the API discovers automatically - leave this unset for those. Set it only on
# older projects that still use the legacy HS256 JWT secret
# (Project Settings > API > JWT Settings > JWT Secret).
# SUPABASE_JWT_SECRET=<legacy jwt secret>

# --- Postgres -----------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string.
# Use the TRANSACTION POOLER (port 6543) - the direct host is IPv6-only and
# unreachable from most CI and PaaS networks. The app disables psycopg's
# prepared statements so it works through pgbouncer. Pool is min 1 / max 5.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Cloudflare R2 ------------------------------------------------------------
# R2 > Manage R2 API Tokens. The endpoint is derived from the account id.
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret access key>
R2_BUCKET=<bucket name>

# Optional. Overrides the derived endpoint - point at a local MinIO or S3 stub
# during development. Leave unset in production.
# R2_ENDPOINT_URL=http://127.0.0.1:9000

# --- Tests --------------------------------------------------------------------
# The suite applies the v3 migration, which DROPS AND RECREATES the labeling
# tables. Point this at a throwaway database, never at production.
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/dynalytix_test
