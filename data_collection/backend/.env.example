# =============================================================================
# Backend environment. Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project URL and keys from Supabase > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Supabase > Project Settings > API > JWT Settings > JWT Secret.
# The API verifies every bearer token against this (HS256).
SUPABASE_JWT_SECRET=<jwt secret>

# --- Postgres -----------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string.
# Use the pooler (port 6543) on Railway; the pool here is min 1 / max 5.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# --- Cloudflare R2 ------------------------------------------------------------
# R2 > Manage R2 API Tokens. The endpoint is derived from the account id.
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret access key>
R2_BUCKET=<bucket name>

# Optional. Overrides the derived endpoint - point at a local MinIO or S3 stub
# during development. Leave unset in production.
# R2_ENDPOINT_URL=http://127.0.0.1:9000

# --- Tests --------------------------------------------------------------------
# The suite applies the v3 migration, which DROPS AND RECREATES the labeling
# tables. Point this at a throwaway database, never at production.
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/dynalytix_test
